# Copy to backend/.env (`make setup` does this). Never commit real secrets.

GITVERSE_ENVIRONMENT=development

# Comma-separated list of browser origins allowed to call the API.
GITVERSE_CORS_ORIGINS=http://localhost:3000

# Reject request bodies larger than this.
GITVERSE_MAX_REQUEST_BODY_BYTES=16384

# Analysis ceilings. Published by /api/v1/meta today; enforced once the pipeline exists.
GITVERSE_LIMIT_MAX_REPO_SIZE_MB=250
GITVERSE_LIMIT_MAX_FILES=20000
GITVERSE_LIMIT_MAX_FILE_SIZE_KB=1024
GITVERSE_LIMIT_ANALYSIS_TIMEOUT_SECONDS=120

# Not used yet. Reserved for GitHub API access and AI explanations.
GITVERSE_GITHUB_TOKEN=
GITVERSE_ANTHROPIC_API_KEY=
