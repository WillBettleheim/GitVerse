# Copy to backend/.env (`make setup` does this). Never commit real secrets.

GITVERSE_ENVIRONMENT=development

# Comma-separated list of browser origins allowed to call the API.
GITVERSE_CORS_ORIGINS=http://localhost:3000

# Reject request bodies larger than this.
GITVERSE_MAX_REQUEST_BODY_BYTES=16384

# Analysis ceilings, enforced while fetching and parsing.
GITVERSE_LIMIT_MAX_REPO_SIZE_MB=100
GITVERSE_LIMIT_MAX_FILES=20000
GITVERSE_LIMIT_MAX_SOURCE_FILES=4000
GITVERSE_LIMIT_MAX_FILE_SIZE_KB=1024
GITVERSE_LIMIT_MAX_TOTAL_SOURCE_MB=60
GITVERSE_LIMIT_MAX_UNPACKED_MB=800
GITVERSE_LIMIT_ANALYSIS_TIMEOUT_SECONDS=120

# Analyses running at once, how many may wait, and new requests per client per minute.
GITVERSE_MAX_CONCURRENT_ANALYSES=2
GITVERSE_MAX_QUEUED_ANALYSES=8
GITVERSE_ANALYSIS_REQUESTS_PER_MINUTE=6

# Finished analyses, keyed by repository and commit. Leave empty to keep them in memory only.
GITVERSE_CACHE_DIR=.cache/analyses

# Optional. A token with no scopes raises GitHub's limit from 60 to 5,000 requests an hour.
GITVERSE_GITHUB_TOKEN=

# Not used yet. Reserved for AI explanations.
GITVERSE_ANTHROPIC_API_KEY=
